NODE_ENV=development
PORT=3000

# true behind a reverse proxy/load balancer, so req.ip reflects the real client
# (used by the setPassword rate limit) instead of the proxy's own address
TRUST_PROXY=false

# Comma-separated list of allowed browser origins for the GraphQL endpoint.
# Left unset: allow all origins in development, deny all in production (NODE_ENV=production).
CORS_ALLOWED_ORIGINS=

POSTGRES_DB=auth_db
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=defina_uma_senha_local_segura
POSTGRES_PORT=5432

# Redis (refresh tokens)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (access token) — segredo com no mínimo 32 caracteres
JWT_ACCESS_SECRET=troque_por_um_segredo_forte_de_32_chars_ou_mais
JWT_ACCESS_TTL=15m

# E-mail (SMTP) — leave MAIL_HOST unset to use ConsoleMailer instead (logs the invite/reset
# links instead of sending them; only picked when NODE_ENV isn't 'production')
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=senha_de_app_do_provedor
MAIL_FROM="Auth Service <your_email@gmail.com>"

# URL used in email links (should point to the page that receives the token)
APP_BASE_URL=http://localhost:3000

# Secondary login rate limit, by IP instead of by email — catches credential stuffing
# (many different emails failing from the same IP). Higher ceiling than the 5-per-email
# limit so it doesn't block legitimate users sharing a NAT/proxy.
LOGIN_IP_RATE_LIMIT_MAX_ATTEMPTS=30
LOGIN_IP_RATE_LIMIT_BLOCK_SECONDS=7200

ADMIN_EMAIL=your_email@gmail.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=admin   
ADMIN_APP_NAME=Admin Console
ADMIN_APP_REDIRECT_URI=http://localhost:3000/callback
ADMIN_ROLE_NAME=admin