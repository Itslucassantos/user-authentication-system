{
  "name": "user-authentication-system",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --passWithNoTests",
    "mail:test": "tsx src/infrastructure/mail/send-test-email.ts",
    "migrate": "tsx src/infrastructure/database/migrate.ts up",
    "migrate:down": "tsx src/infrastructure/database/migrate.ts down",
    "migrate:pending": "tsx src/infrastructure/database/migrate.ts pending",
    "migrate:executed": "tsx src/infrastructure/database/migrate.ts executed",
    "seed:admin": "tsx src/infrastructure/database/seed-admin.ts",
    "docs:api": "tsx src/interface/graphql/generate-docs.ts",
    "codegen": "npm run docs:api && graphql-codegen --config codegen.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Itslucassantos/user-authentication-system.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Itslucassantos/user-authentication-system/issues"
  },
  "homepage": "https://github.com/Itslucassantos/user-authentication-system#readme",
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@graphql-tools/schema": "^10.1.1",
    "@graphql-tools/utils": "^12.0.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dataloader": "^2.2.3",
    "express": "^5.2.1",
    "graphql": "^16.14.2",
    "graphql-depth-limit": "^1.1.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limiter-flexible": "^11.2.1",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "umzug": "^3.8.3",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/typescript": "^6.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/graphql-depth-limit": "^1.1.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "babel-jest": "^30.5.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "graphql-markdown": "^7.3.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
